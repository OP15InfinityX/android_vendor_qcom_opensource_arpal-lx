cc_library_shared {
    name: "libpaleventnotifier",
    owner: "qti",
    vendor: true,

    // This product uses the OxygenOS 16.0.8 prebuilt (paleventnotifier AIDL V2).
    // Do not analyze the unused source implementation's V3 dependency together
    // with that preferred prebuilt. The stock library remains enabled.
    enabled: false,

    tidy: true,

    cflags: [
        "-v",
        "-Wall",
        "-Wthread-safety",
    ],

    srcs: [
        "PalServerNotify.cpp",
        "Service.cpp",
    ],

    header_libs: [
        "libarpal_headers",
        "libspf-headers",
    ],

    shared_libs: [
        "libar-pal",
        "libbase",
        "libbinder_ndk",
        "libcutils",
        "liblog",
        "libutils",
        "vendor.qti.hardware.pal-V1-ndk",
        "vendor.qti.hardware.paleventnotifier-V3-ndk",
    ],

    static_libs: [
        "libaidlcommonsupport",
        "libpalaidltypeconverter",
    ],
}
